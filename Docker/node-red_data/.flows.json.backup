    {
        "id": "24660cf1188415aa",
        "type": "function",
        "z": "a9c03d3f35ffc9ac",
        "name": "Split + Tags v1.5",
        "func": "// 1. OBTENCIÓN DE DATOS\nvar inputData = msg.payload;\nif (typeof inputData === \"string\") {\n    try { inputData = JSON.parse(inputData); } catch (e) {}\n}\n\nvar nodeId = inputData.id || \"unknown\";\n\n// --- 2. ASIGNACIÓN DE IDENTIDAD ---\nvar clientName = \"Dango_Prototype\";\nvar locationName = \"Lab_General\";\n\n// SIN ESPACIOS en los nombres de los tags para evitar romper el Line Protocol\nif (nodeId === \"Dango_Node_001\" || nodeId === \"Telescopio_01\") {\n    clientName = \"Observatorio_Nacional\";\n    locationName = \"Base_Acimutal\";\n} else if (nodeId === \"Dango_Node_002\" || nodeId === \"Industria_SRO\") {\n    clientName = \"Industria_SRO\";\n    locationName = \"Cinta_Transportadora\";\n}\n\nvar msgsToSend = [];\n\n// Función para crear Line Protocol\nfunction createLine(sensorName, d) {\n    var ax = parseFloat(d.ax);\n    var ay = parseFloat(d.ay);\n    var az = parseFloat(d.az);\n    var mag = Math.sqrt(ax*ax + ay*ay + az*az).toFixed(4);\n\n    // CONSTRUCCIÓN DEL STRING (LINE PROTOCOL)\n    // Sintaxis: medicion,tag1=val,tag2=val campo1=val,campo2=val\n    var line = `vibration_sensor,client=${clientName},node=${nodeId},location=${locationName},sensor=${sensorName} ax=${ax},ay=${ay},az=${az},mag_acc=${mag}`;\n    \n    return { \n        payload: line, \n        measurement: \"vibration_sensor\" // <--- ESTO ES EL TRUCO\n        // Ponemos esto aquí solo para que el nodo de Influx no dé error de \"No measurement\".\n        // Pero lo que realmente se escribe en la BD es la línea de arriba (payload).\n    };\n}\n\n// Procesar sensores\nif (inputData.s1) msgsToSend.push(createLine(\"s1\", inputData.s1));\nif (inputData.s2) msgsToSend.push(createLine(\"s2\", inputData.s2));\n\nreturn [msgsToSend];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 280,
        "y": 320,
        "wires": [
            []
        ]
    },
    {
        "id": "f7dd0366bd5ee07a",
        "type": "function",
        "z": "a9c03d3f35ffc9ac",
        "name": "Split + Tags v1.5 ds",
        "func": "// 1. OBTENCIÓN DE DATOS\nvar inputData = msg.payload;\nif (typeof inputData === \"string\") {\n    try { \n        inputData = JSON.parse(inputData); \n    } catch (e) {\n        node.error(\"Error parseando JSON: \" + e.toString());\n        return null;\n    }\n}\n\nvar nodeId = inputData.id || \"unknown\";\n\n// --- 2. ASIGNACIÓN DE IDENTIDAD ---\nvar clientName = \"Dango_Prototype\";\nvar locationName = \"Lab_General\";\n\nif (nodeId === \"Dango_Node_001\" || nodeId === \"Telescopio_01\") {\n    clientName = \"Observatorio_Nacional\";\n    locationName = \"Base_Acimutal\";\n} else if (nodeId === \"Dango_Node_002\" || nodeId === \"Industria_SRO\") {\n    clientName = \"Industria_SRO\";\n    locationName = \"Cinta_Transportadora\";\n}\n\nvar msgsToSend = [];\n\nfunction createLineProtocol(sensorName, data) {\n    var ax = parseFloat(data.ax) || 0;\n    var ay = parseFloat(data.ay) || 0;\n    var az = parseFloat(data.az) || 0;\n    var mag = Math.sqrt(ax*ax + ay*ay + az*az).toFixed(4);\n    \n    // FORMATO LINE PROTOCOL CORRECTO:\n    // measurement,tag1=value,tag2=value field1=value,field2=value timestamp\n    // NOTA: Sin espacios después de las comas en los tags\n    var line = `vibration_sensor,node=${nodeId},sensor=${sensorName},location=${locationName},client=${clientName},organization=Dango_Prototype ax=${ax},ay=${ay},az=${az},mag_acc=${mag}`;\n    \n    return { \n        payload: line  // Solo envía el string de línea\n    };\n}\n\n// Procesar sensores\nif (inputData.s1) {\n    msgsToSend.push(createLineProtocol(\"s1\", inputData.s1));\n}\n\nif (inputData.s2) {\n    msgsToSend.push(createLineProtocol(\"s2\", inputData.s2));\n}\n\nreturn msgsToSend;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 510,
        "y": 320,
        "wires": [
            [
                "b67629c210e79be8",
                "9c4273544543e985"
            ]
        ]
