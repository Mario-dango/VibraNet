    {
        "id": "851ded7cd5e93fc4",
        "type": "function",
        "z": "a9c03d3f35ffc9ac",
        "name": "test",
        "func": "\n// --- 2. OBTENCIÓN Y LIMPIEZA DE DATOS ---\nvar inputData = msg.payload;\nif (typeof inputData === \"string\") {\n    try { inputData = JSON.parse(inputData); } catch (e) {}\n}\n\nvar nodeId = inputData.id || \"unknown\";\n\n// --- 3. LÓGICA DE NEGOCIO (Tags) ---\n// Definimos quién es el cliente y dónde está\nvar clientName = \"Dango_Prototype\";\nvar locationName = \"Lab_General\";\n\nif (nodeId === \"Dango_Node_001\" || nodeId === \"Telescopio_01\") {\n    clientName = \"Observatorio_Nacional\";\n    locationName = \"Base_Acimutal\";\n} else if (nodeId === \"Dango_Node_002\" || nodeId === \"Industria_SRO\") {\n    clientName = \"Industria_SRO\";\n    locationName = \"Cinta_Transportadora\";\n}\n\n// Calculamos magnitud (pitágoras 3D)\nvar sensores = [[],[]];\n// Función auxiliar para formatear una línea\nfunction addLine(sensorName, d) {\n    var data = [];\n    // Aseguramos que sean números flotantes\n    data[0] = parseFloat(d.ax);\n    data[1] = parseFloat(d.ay);\n    data[2] = parseFloat(d.az);\n    // Calculamos magnitud (pitágoras 3D)\n    data[3] = Math.sqrt(data[0]*data[0] + \n                        data[1]*data[1] + \n                        data[2]*data[2]).toFixed(4);\n    if (sensorName == 's1'){\n      sensores[0] = data;\n    } else if (sensorName == 's2') {\n      sensores[1] = data;\n    }\n}\n\nmsg.payload = {\n  // You bucket\n  // Optional (it can be defined in the node credentials settings)\n  bucket: 'test',\n\n  // Precision of timestamp\n  // Optional\n  // Can be `ns` (nanoseconds),\n  //        `us` (microseconds),\n  //        `ms` (milliseconds),\n  //        `s` (seconds).\n  // The default is `ns`\n  // Note: if you set the `timestamp` field to `Date.now()`, you have to set the `precision` to `ms`\n  precision: 'ms',\n\n  // Data to send to InfluxDB\n  // Can be an array of objects or only one object\n  data: [\n    {\n      measurement: 'vibration',\n\n      tags: {\n        clientName: clientName,\n        locationName: locationName,\n        softwareVersion: '2.5.1',\n        hardwareVersion: '1.5',\n        redSSID: 'factory-1',\n        sensor: 's1'\n      },\n\n      fields: {\n        ax: sensores[0][0],\n        ay: sensores[0][1],\n        az: sensores[0][2],\n        mag_acc: sensores[0][3]\n      },\n\n      timestamp: Date.now()\n    },\n\n    {\n      measurement: 'vibration',\n\n      tags: {\n        clientName: clientName,\n        locationName: locationName,\n        softwareVersion: '2.5.1',\n        hardwareVersion: '1.5',\n        redSSID: 'factory-1',\n        sensor: 's2'\n      },\n\n      fields: {\n        ax: sensores[1][0],\n        ay: sensores[1][1],\n        az: sensores[1][2],\n        mag_acc: sensores[1][3]\n        // -> evaluar si enviar SSID de red o setearlo manualmente\n      },\n\n      timestamp: Date.now()\n    },\n\n    // More data can be send here, simply re add an object\n    // { ... },\n  ]\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
