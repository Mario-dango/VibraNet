    {
        "id": "e280d4caffdd443a",
        "type": "function",
        "z": "4cbfa92d75bed567",
        "name": "nodo to influxdb",
        "func": "// Obtener el payload parseado\nvar rawData = msg.payload;\nvar device = rawData.device_id;\nvar outputPoints = [];\n\n// Recorremos las claves dentro de \"sensors\" (mpu_1, mpu_2, etc.)\n// Esto hace que el código funcione igual si hay 1, 2 o 20 sensores.\nfor (var sensorName in rawData.sensors) {\n    if (rawData.sensors.hasOwnProperty(sensorName)) {\n        var readings = rawData.sensors[sensorName];\n\n        // Estructura para nodo node-red-contrib-influxdb\n        outputPoints.push({\n            measurement: \"aceleracion_raw\", // Nombre de la tabla\n            tags: {\n                host: device,          // Tag: qué ESP8266 es\n                sensor_id: sensorName  // Tag: qué MPU es (mpu_1 o mpu_2)\n            },\n            fields: {\n                ax: parseFloat(readings.ax),\n                ay: parseFloat(readings.ay),\n                az: parseFloat(readings.az)\n            },\n            // Opcional: Si el ESP envía timestamp, úsalo. Si no, Influx usa la hora actual.\n            // timestamp: new Date() \n        });\n    }\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 400,
        "wires": [
            []
        ]
    },
