    {
        "id": "ea65d4103f162701",
        "type": "function",
        "z": "a9c03d3f35ffc9ac",
        "name": "fake_node_simulator",
        "func": "// SIMULADOR DE NODO INDUSTRIAL (Ej: Motor de Cinta)\n// ID diferente para que el sistema lo reconozca como otro cliente\nvar fakeNodeId = \"Dango_Node_Sim_02\"; \n\n// Generamos vibración sintética\n// Usamos Math.sin() para simular rotación y Math.random() para ruido/vibración\nvar time = new Date().getTime() / 1000; // Tiempo en segundos\nvar freq = 5; // Frecuencia de vibración simulada (5Hz)\n\nfunction getVibration(amplitude, noiseLevel) {\n    // Señal base (onda) + Ruido aleatorio\n    return (Math.sin(time * freq) * amplitude) + ((Math.random() - 0.5) * noiseLevel);\n}\n\n// Creamos el payload idéntico al del ESP8266 real\nvar simulatedPayload = {\n    id: fakeNodeId,\n    s1: {\n        // Sensor 1: Mucha vibración (simula un motor desbalanceado)\n        ax: getVibration(0.8, 0.2).toFixed(2),\n        ay: getVibration(0.5, 0.1).toFixed(2),\n        az: (9.8 + getVibration(0.2, 0.1)).toFixed(2) // Gravedad + vibración vertical\n    },\n    s2: {\n        // Sensor 2: Poca vibración (estructura estable)\n        ax: getVibration(0.05, 0.01).toFixed(2),\n        ay: getVibration(0.05, 0.01).toFixed(2),\n        az: (9.8 + getVibration(0.02, 0.01)).toFixed(2)\n    }\n};\n\nmsg.payload = simulatedPayload; // Enviamos como Objeto JSON\n// IMPORTANTE: El nodo MQTT out debe encargarse de hacer JSON.stringify \n// o puedes hacerlo aquí con msg.payload = JSON.stringify(simulatedPayload);\n\n// Usamos el mismo tópico que el real\nmsg.topic = \"dango/iot/sensors\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 440,
        "wires": [
            []
        ]
    },
