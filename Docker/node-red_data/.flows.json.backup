    {
        "id": "8036710d4f2ea4d0",
        "type": "function",
        "z": "a9c03d3f35ffc9ac",
        "name": "Test tag",
        "func": "\n// --- CONFIGURACIÓN ---\nvar token = \"7FAY819FfUvp5T3fhz0yId-jwd5Lg_c0OnNbhADkSdBW0pWMQmR7cPjf5zZq3Yo710vJEC0u-qbJBKH4lWxFEQ==\"; // <--- PEGA TU TOKEN\nvar org = \"Dango Prototype\";\nvar bucket = \"final\"; // Usamos el bucket que YA SABEMOS que anda\nvar ip_influx = \"influxdb\"; // <--- PON LA IP DE TU PC (NO localhost)\n\n// --- DATOS SIMULADOS ---\nvar temp = 20 + Math.random();\nvar hum = 50 + Math.random();\n\n// --- LA MAGIA: LINE PROTOCOL ---\n// Construimos la MISMA frase que escribiste a mano.\n// Estructura: medida,tag1=val,tag2=val campo1=val,campo2=val\n// Fíjate: NO hay espacios después de las comas. Solo UN espacio antes de los valores.\n\nmsg.payload = \"prueba_manual,lugar=DesdeNodeRed,sensor=Sensor_Automatico temperatura=\" + temp.toFixed(2) + \",humedad=\" + hum.toFixed(2);\n\n\n// --- PREPARAR EL ENVÍO HTTP ---\nmsg.headers = {\n    \"Authorization\": \"Token \" + token,\n    \"Content-Type\": \"text/plain; charset=utf-8\",\n    \"Accept\": \"application/json\"\n};\n\n// URL de la API (Es lo mismo que hace el botón \"Write\")\nmsg.url = \"http://\" + ip_influx + \":8086/api/v2/write?org=\" + encodeURIComponent(org) + \"&bucket=\" + encodeURIComponent(bucket) + \"&precision=s\";\n// msg.method = \"POST\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 260,
        "y": 1060,
        "wires": [
            [
                "3c066bb65800a997"
            ]
        ]
    },
