    {
        "id": "29ed9fec4a708bf1",
        "type": "function",
        "z": "a9c03d3f35ffc9ac",
        "d": true,
        "name": "Test Injector",
        "func": "// 1. Definimos la TABLA (Measurement)\nmsg.measurement = \"vibration_sensor\";\n\n// 2. Definimos los DATOS NUMÉRICOS (Fields)\n// InfluxDB solo grafica lo que vaya aquí dentro\nmsg.payload = {\n    ax: 12.5,\n    ay: 0.5,\n    az: 9.8,\n    mag_acc: 15.0\n};\n\n// 3. Definimos los FILTROS (Tags)\n// Esto va SEPARADO del payload para obligar al nodo a reconocerlo como tag\nmsg.tags = {\n    location: \"LABORATORIO\",\n    sensor: \"s1\",\n    client: \"Dango_Prototype\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 290,
        "y": 720,
        "wires": [
