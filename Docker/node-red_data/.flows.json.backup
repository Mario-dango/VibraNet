    {
        "id": "3efeb412fba4491a",
        "type": "function",
        "z": "a9c03d3f35ffc9ac",
        "name": "Split+tag+http",
        "func": "// --- 1. CONFIGURACIÓN DE LA CONEXIÓN (¡Edita esto!) ---\nvar token = \"7FAY819FfUvp5T3fhz0yId-jwd5Lg_c0OnNbhADkSdBW0pWMQmR7cPjf5zZq3Yo710vJEC0u-qbJBKH4lWxFEQ==\"; \nvar ip_influx = \"192.168.100.68\"; // La IP de tu PC (la que usaste recién y anduvo)\nvar org = \"Dango Prototype\";\nvar bucket = \"Vibranet_data\"; // El bucket real\n\n// --- 2. OBTENCIÓN Y LIMPIEZA DE DATOS ---\nvar inputData = msg.payload;\nif (typeof inputData === \"string\") {\n    try { inputData = JSON.parse(inputData); } catch (e) {}\n}\n\nvar nodeId = inputData.id || \"unknown\";\n\n// --- 3. LÓGICA DE NEGOCIO (Tags) ---\n// Definimos quién es el cliente y dónde está\nvar clientName = \"Dango_Prototype\";\nvar locationName = \"Lab_General\";\n\nif (nodeId === \"Dango_Node_001\" || nodeId === \"Telescopio_01\") {\n    clientName = \"Observatorio_Nacional\";\n    locationName = \"Base_Acimutal\";\n} else if (nodeId === \"Dango_Node_002\" || nodeId === \"Industria_SRO\") {\n    clientName = \"Industria_SRO\";\n    locationName = \"Cinta_Transportadora\";\n}\n\n// --- 4. CONSTRUCCIÓN DEL LINE PROTOCOL ---\nvar lines = []; // Aquí guardaremos las líneas de texto\n\n// Función auxiliar para formatear una línea\nfunction addLine(sensorName, d) {\n    // Aseguramos que sean números flotantes\n    var ax = parseFloat(d.ax);\n    var ay = parseFloat(d.ay);\n    var az = parseFloat(d.az);\n    // Calculamos magnitud (pitágoras 3D)\n    var mag = Math.sqrt(ax*ax + ay*ay + az*az).toFixed(4);\n\n    // ESTRUCTURA: medicion,tag1=val,tag2=val campo1=val,campo2=val\n    // IMPORTANTE: Sin espacios después de las comas.\n    var line = `vibration_sensor,client=${clientName},node=${nodeId},location=${locationName},sensor=${sensorName} ax=${ax},ay=${ay},az=${az},mag_acc=${mag}`;\n    \n    lines.push(line);\n}\n\n// Procesar sensores si existen en el JSON\nif (inputData.s1) addLine(\"s1\", inputData.s1);\nif (inputData.s2) addLine(\"s2\", inputData.s2);\n// Si tienes más sensores (s3, s4), agrégalos aquí...\n\n// --- 5. PREPARACIÓN DEL ENVÍO HTTP ---\n\n// Si no se generaron líneas (llegó basura), no hacemos nada\nif (lines.length === 0) return null;\n\n// Unimos todas las líneas con un salto de línea (\\n) para enviarlas juntas\nmsg.payload = lines.join(\"\\n\");\n\nmsg.headers = {\n    \"Authorization\": \"Token \" + token,\n    \"Content-Type\": \"text/plain; charset=utf-8\",\n    \"Accept\": \"application/json\"\n};\n\nmsg.url = \"http://\" + ip_influx + \":8086/api/v2/write?org=\" + encodeURIComponent(org) + \"&bucket=\" + encodeURIComponent(bucket) + \"&precision=s\";\n\n// Forzamos que sea un POST (aunque ya configuraste el nodo amarillo, esto asegura el tiro)\n// NOTA: Recuerda borrar el warning amarillo en el nodo http request poniendo el metodo en POST\n// pero si lo dejaste configurado, esta linea es redundante (no daña).\n// msg.method = \"POST\"; \n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 1300,
        "wires": [
            [
                "fc995dae6aa1da44"
            ]
        ]
    },
