    {
        "id": "dff0d6602d907caf",
        "type": "function",
        "z": "a9c03d3f35ffc9ac",
        "name": "Split + Tags v1.0",
        "func": "// 1. OBTENCIÓN Y LIMPIEZA DE DATOS\nvar payload = msg.payload;\n\n// Protección por si llega como String\nif (typeof payload === \"string\") {\n    try {\n        payload = JSON.parse(payload);\n    } catch (e) {\n        node.error(\"Error parseando JSON\", e);\n        return null;\n    }\n}\n\nvar nodeId = payload.id || \"unknown\";\nvar msgsToSend = []; // Aquí guardaremos los mensajes para enviar\n\n// Función para crear un MENSAJE COMPLETO de Node-RED\nfunction createMessage(sensorName, dataObj) {\n    return {\n        // 1. La medida va en la raíz del mensaje\n        measurement: \"vibration_sensor\",\n        \n        // 2. Los datos numéricos (Fields) van en el payload\n        payload: {\n            ax: parseFloat(dataObj.ax),\n            ay: parseFloat(dataObj.ay),\n            az: parseFloat(dataObj.az),\n            mag_acc: Math.sqrt(Math.pow(dataObj.ax, 2) + Math.pow(dataObj.ay, 2) + Math.pow(dataObj.az, 2))\n        },\n        \n        // 3. Las etiquetas (Tags) van en su propio objeto msg.tags\n        // (Esto suele funcionar mejor que ponerlas dentro del payload)\n        tags: {\n            node: nodeId,\n            sensor: sensorName,\n            location: \"motor_principal\",\n            organization: \"Dango Prototype\"\n        }\n    };\n}\n\n// Procesar Sensor 1\nif (payload.s1) {\n    msgsToSend.push(createMessage(\"s1\", payload.s1));\n}\n\n// Procesar Sensor 2\nif (payload.s2) {\n    msgsToSend.push(createMessage(\"s2\", payload.s2));\n}\n\n// En Node-RED, si retornas un array de array [[msg1, msg2]], \n// los envía secuencialmente por la misma salida.\nreturn [msgsToSend];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 220,
        "wires": [
            [
                "b67629c210e79be8",
                "9c4273544543e985"
            ]
        ]
    },
    {
        "id": "6cde85fcfa58bebb",
        "type": "function",
        "z": "a9c03d3f35ffc9ac",
        "name": "fake_node_simulator v1.5",
        "func": "// Simulador de Dango_Node_002 (Industria)\nvar idSimulado = \"Dango_Node_002\";\n\n// Generamos valores aleatorios diferentes al sensor real\n// Para que se note en la gráfica (valores más altos)\nfunction randomVib(min, max) {\n    return (Math.random() * (max - min) + min).toFixed(2);\n}\n\nmsg.payload = {\n    id: idSimulado,\n    s1: {\n        // Simulamos un motor vibrando fuerte\n        ax: randomVib(2.0, 3.5), \n        ay: randomVib(0.5, 1.0),\n        az: randomVib(9.5, 10.5)\n    },\n    s2: {\n        // Simulamos una base más estable\n        ax: randomVib(0.1, 0.3),\n        ay: randomVib(0.1, 0.3),\n        az: randomVib(9.7, 9.9)\n    }\n};\n\n// Importante: No tocamos el msg.topic, dejamos que el flujo siga\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
        "y": 520,
        "wires": [
            []
        ]
    },
