        "func": "// Simulamos un sensor de temperatura\nmsg.payload = {\n    temp: 20 + Math.random() * 5, // Numero aleatorio entre 20 y 25\n    humedad: 50\n};\n// La \"measurement\" es como el nombre de la tabla\nmsg.measurement = \"cuarto_servidor\";\nreturn msg;",
